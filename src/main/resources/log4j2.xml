<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <!--
          ConsoleAppender: Writes to standard output.
          Plain message-only format so the console output reads like normal program output.
        -->
        <Console name="ConsoleAppender" target="SYSTEM_OUT">
            <PatternLayout pattern="%msg%n" charset="UTF-8" />
        </Console>

        <!--
          FileAppender: Writes structured diagnostics to "SerialController.log".
          Full pattern including timestamp, thread, level, and source location.
          Rolls to a new file each day; old files are named SerialController-yyyy-MM-dd.log.
        -->
        <RollingFile name="FileAppender"
                     fileName="SerialController.log"
                     filePattern="SerialController-%d{yyyy-MM-dd}.log"
                     immediateFlush="true"
                     append="true">
            <PatternLayout
                    pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%-30.30t] %-5level %-45logger{1.1.1}:%4L - %msg%n" />
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" />
            </Policies>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!--
          Root Logger: Catches third-party library logging (Jetty, jSerialComm, Jackson, …).
          Routed to the file only to keep the console clean.
        -->
        <Root level="WARN">
            <AppenderRef ref="FileAppender" />
        </Root>

        <!--
          io.javalin Logger: Javalin startup banner and server lifecycle messages.
          - Console: WARN and above by default - startup noise suppressed unless DEBUG/TRACE
                     is requested via serialcontroller.log.level (applyLogLevel updates this).
          - File: INFO and above - full record always written.
        -->
        <Logger name="io.javalin" level="INFO" additivity="false">
            <AppenderRef ref="ConsoleAppender">
                <ThresholdFilter level="WARN" onMatch="ACCEPT" onMismatch="DENY" />
            </AppenderRef>
            <AppenderRef ref="FileAppender" />
        </Logger>

        <!--
          com.serial Logger: Single logger for all application code.
          - Default level: INFO (set by logger attribute below).
          - Console: INFO and above by default (ThresholdFilter); applyLogLevel() replaces this
                     filter dynamically - e.g. DEBUG shows TX/RX hex, TRACE adds decoded annotations.
          - File: same as effective logger level - no additional filter on the FileAppender ref.
            Log levels used by the application:
              INFO  - lifecycle events, detection results, user-initiated writes.
              DEBUG - raw Modbus TX/RX hex frames + REST API calls.
              TRACE - decoded Modbus frame annotations (register name + value).
        -->
        <Logger name="com.serial" level="INFO" additivity="false">
            <AppenderRef ref="ConsoleAppender">
                <ThresholdFilter level="INFO" onMatch="ACCEPT" onMismatch="DENY" />
            </AppenderRef>
            <AppenderRef ref="FileAppender" />
        </Logger>
    </Loggers>
</Configuration>
